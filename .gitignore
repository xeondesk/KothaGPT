# ============================================================
# Kotha GPT — Git ignore
# ============================================================

# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Rust
target/

# TypeScript / JavaScript / Node
node_modules/
*.tsbuildinfo
.next/
out/
coverage/

# Go
bin/
*.test

# Environment / secrets (keep the example)
.env
.env.*
!.env.example

# Caches / runtime data
.cache/
data/cache/

# Model & training outputs (git-ignored; CI regenerates from fixtures)
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
ml/tokenizer/artifacts/
models/
checkpoints/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp