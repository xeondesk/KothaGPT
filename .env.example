# ============================================================
# Kotha GPT — Environment Configuration
# ============================================================
# Copy:
#   cp .env.example .env
#
# Never commit .env or real secrets.
# ============================================================

# Application
APP_NAME=kothagpt
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
TIMEZONE=Asia/Dhaka

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai
POSTGRES_USER=ai
POSTGRES_PASSWORD=ai
DATABASE_URL=postgresql://ai:ai@localhost:5432/ai

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kothagpt

# Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kothagpt
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Model
MODEL_NAME=kothagpt
MODEL_VERSION=0.1.0
MODEL_PATH=./models
MODEL_CONFIG=./configs/model.yaml
MODEL_DEVICE=auto
MODEL_DTYPE=bf16
MODEL_CONTEXT_LENGTH=4096

# Tokenizer
TOKENIZER_NAME=kothagpt-bn
TOKENIZER_PATH=./ml/tokenizer/artifacts
TOKENIZER_VOCAB_SIZE=50000

# Training
TRAINING_ENABLED=false
TRAINING_CONFIG=./ml/configs/small.yaml
TRAINING_OUTPUT_DIR=./checkpoints
TRAINING_SEED=42
TRAINING_BATCH_SIZE=2
TRAINING_GRADIENT_ACCUMULATION=16
TRAINING_LEARNING_RATE=0.0003
TRAINING_MAX_STEPS=1000
TRAINING_MIXED_PRECISION=bf16

# Dataset
DATA_ROOT=./data
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_CACHE_DIR=./data/cache
DATASET_NAME=kothagpt-bangla
DATASET_VERSION=0.1.0

# Hugging Face
HF_HOME=./.cache/huggingface
HF_HUB_CACHE=./.cache/huggingface/hub
HF_TOKEN=

# Inference
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8001
INFERENCE_WORKERS=1
INFERENCE_MAX_BATCH_SIZE=8
INFERENCE_MAX_CONCURRENT_REQUESTS=32
INFERENCE_TIMEOUT_SECONDS=120

# Backend selection for the API (mock | canned | hf)
KOTHAGPT_BACKEND=mock
# Mock backend agent/run state store. With REDIS_URL or DATABASE_URL set above,
# state survives instance restarts (required for ephemeral hosts, e.g. Vercel).
# Override both with KOTHAGPT_AGENT_STORE_URL; unset = in-memory per instance.
#KOTHAGPT_AGENT_STORE_URL=
# Used by the "hf" backend (tiny example model). Requires services/api/requirements-hf.txt.
KOTHAGPT_EXAMPLE_MODEL=hf-internal-testing/tiny-random-gpt2
KOTHAGPT_MAX_NEW_TOKENS=32

# RAG / Embeddings
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_RERANKER_MODEL=

# Agents
AGENTS_ENABLED=false
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_MEMORY_ENABLED=true
AGENT_TOOL_CALLS_ENABLED=false

# Security
SECRET_KEY=change-me-in-development
JWT_SECRET_KEY=change-me-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=kothagpt
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_ENABLED=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Kotha GPT

# Optional external providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Python
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1